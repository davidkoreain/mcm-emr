# Supabase — copy this file to .env.local and fill in your project values
# Get these from: https://supabase.com/dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Without these set, the app uses LocalService (in-memory, resets on refresh)
# With these set, the app uses SupabaseService (real PostgreSQL, persists across sessions)
